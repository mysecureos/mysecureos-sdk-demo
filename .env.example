# Copy this file to .env and fill in real values — .env is gitignored,
# .env.example is not (it holds no secrets, just the shape).

# The MySecureOS API this proxy forwards to.
MYSECUREOS_BASE_URL=http://localhost:4000

# A trusted-partner API key, generated from the tenant dashboard's
# Settings > API Keys (http://localhost:3000/tenant/settings). Shown once,
# at creation — never committed, never sent to the phone app.
MYSECUREOS_API_KEY=msk_live_your_key_here

# Port this proxy listens on (the mobile app's EXPO_PUBLIC_PROXY_URL should match).
PORT=4100
