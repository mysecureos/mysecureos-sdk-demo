# Copy this file to .env and fill in real values. .env is gitignored;
# .env.example is committed and holds no secrets, only the shape.

# The MySecureOS API that server.ts forwards to.
# WARNING: emergencies activated against a live MySecureOS environment are
# real and can dispatch armed response. Ask MySecureOS for a test environment
# or test credentials before you press SOS.
MYSECUREOS_BASE_URL=https://api.mysecureos.co.za

# Your trusted-partner API key, from the MySecureOS dashboard:
# Company Settings > API Keys > Generate new key. It's shown only once, when
# you create it. Never commit it, and never put it in the mobile app.
MYSECUREOS_API_KEY=msk_live_your_key_here

# The port server.ts listens on. The app's EXPO_PUBLIC_PROXY_URL should match.
PORT=4100
